generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BiologicalSex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model User {
  id String @id @default(uuid())
  email String @unique
  weightKg Float
  heightCm Float
  age Int
  sex BiologicalSex
  activityLevel ActivityLevel
  targetCalories Int
  createdAt DateTime @default(now())
  weightLogs BodyWeigthLog[]
  daylyLogs DailyLog[]
}

model BodyWeigthLog {
  id String @id @default(uuid())
  userId String
  date DateTime @db.Date
  weightKg Float
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Food {
  id String @id @default(uuid())
  name String
  caloriesPer100g Int
  proteinPer100g Float
  carbsPer100g Float
  fatPer100g Float
  foodEntries FoodEntry[]
}
